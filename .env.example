# Backend Environment Variables

## Server Configuration
NODE_ENV=development
PORT=3000
SERVER_TIMEOUT=30000

## Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=safargo
DB_PASSWORD=safargo123
DB_DATABASE=safargo_dev
DB_SYNCHRONIZE=true
DB_LOGGING=true

## Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

## JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=900 # 15 minutes
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=2592000 # 30 days

## Encryption
ENCRYPTION_KEY=your_encryption_key_32_bytes
ENCRYPTION_IV=your_initialization_vector_16_bytes

## SMS Gateway
SMS_PROVIDER=twilio # or other provider
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

## Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

## Payment Gateways
# Click
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_MERCHANT_KEY=your_click_merchant_key

# Payme
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_MERCHANT_KEY=your_payme_merchant_key

# Uzum Bank
UZUM_MERCHANT_ID=your_uzum_merchant_id
UZUM_API_KEY=your_uzum_api_key

## Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
YANDEX_MAPS_API_KEY=your_yandex_maps_api_key

## AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=safargo-files

## Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@safargo.uz

## Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

## CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

## API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api/docs

## WebSocket Configuration
WS_ENABLED=true
WS_PORT=3001

## Feature Flags
FEATURE_RIDE_SHARING=true
FEATURE_SCHEDULED_RIDES=true
FEATURE_EMERGENCY_SOS=true

## AI Services
AI_IMAGE_VERIFICATION_URL=http://localhost:5000
AI_FRAUD_DETECTION_URL=http://localhost:5001

## Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn
